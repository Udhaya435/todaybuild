# Server Configuration
PORT=5000
NODE_ENV=development
API_BASE_URL=http://localhost:5000

# Database Connection (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/nova_voicemail?schema=public"

# Authentication
JWT_SECRET="nova_live_voicemail_ultra_secure_jwt_secret_key_2026"
JWT_EXPIRATION="7d"

# OpenAI API Key (Summarization, Entity Extraction, Tamil/English replies, Whisper, TTS)
OPENAI_API_KEY="sk-..."

# Speech-to-Text / Streaming Transcription (Deepgram or Whisper)
DEEPGRAM_API_KEY=""

# Telephony Provider (Twilio / Telnyx / SIP)
TWILIO_ACCOUNT_SID="AC..."
TWILIO_AUTH_TOKEN="..."
TWILIO_PHONE_NUMBER="+1XXXXXXXXXX"
TWILIO_WEBHOOK_SECRET="..."

# Audio Storage (AWS S3 or Local Cloud Emulation)
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="us-east-1"
S3_BUCKET_NAME="nova-voicemail-recordings"
STORAGE_PUBLIC_BASE_URL="http://localhost:5000/recordings"
